{
  "name": "railswitch",
  "version": "0.1.3",
  "description": "Official TypeScript SDK for RailSwitch — recurring billing recovery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs --clean",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "railswitch",
    "subscriptions",
    "billing",
    "nomba",
    "recurring",
    "nigeria"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
